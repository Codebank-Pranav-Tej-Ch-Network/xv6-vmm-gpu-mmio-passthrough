diff --git a/sysproc.c b/sysproc.c
index 0686d29..a59f7e5 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,32 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+int
+sys_map_mmio(void)
+{
+  uint vaddr;
+  struct proc *curproc = myproc();
+
+  if(argint(0, (int*)&vaddr) < 0)
+    return -1;
+
+  if(vaddr % PGSIZE != 0)
+    return -1;
+  if(vaddr < curproc->sz || vaddr >= KERNBASE || vaddr + PGSIZE > KERNBASE)
+    return -1;
+
+  if(mappages(curproc->pgdir, (void*)vaddr, PGSIZE, GPU_PHYADDR, PTE_U | PTE_W | PTE_R) < 0)
+    return -1;
+
+  memset(P2V(GPU_PHYADDR), 0, PGSIZE);
+  lcr3(V2P(curproc->pgdir));
+  return 0;
+}
+
+int
+sys_vm_enter(void)
+{
+  myproc()->is_guest = 1;
+  return 0;
+}
