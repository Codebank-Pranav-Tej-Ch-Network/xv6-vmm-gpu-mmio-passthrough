 // Interrupt descriptor table (shared by all CPUs).
 struct gatedesc idt[256];
@@ -32,6 +33,23 @@ idtinit(void)
   lidt(idt, sizeof(idt));
 }
 
+void
+vmm_emulate(void)
+{
+  struct proc *curproc = myproc();
+
+  if(curproc->tf->eax == SYS_uptime){
+    curproc->tf->eax = 9999;
+    cprintf("Uptime: %d\n", curproc->tf->eax);
+  } else {
+    volatile uint *gpu_bar = (volatile uint *)P2V(GPU_PHYADDR);
+    if(*gpu_bar == 0xDEADBEEF)
+      cprintf("Command 0xDEADBEEF sent directly to hardware.\n");
+    cprintf("VMM: Unhandled VMEXIT trap!\n");
+    curproc->killed = 1;
+  }
+}
+
 //PAGEBREAK: 41
 void
 trap(struct trapframe *tf)
@@ -40,7 +58,15 @@ trap(struct trapframe *tf)
     if(myproc()->killed)
       exit();
     myproc()->tf = tf;
-    syscall();
+
+    if (myproc()->is_guest) {
+      // VMEXIT: The guest tried to perform a privileged operation
+      vmm_emulate();
+    } else {
+      // Standard Host OS process
+      syscall();
+    }
+
     if(myproc()->killed)
       exit();
     return;
